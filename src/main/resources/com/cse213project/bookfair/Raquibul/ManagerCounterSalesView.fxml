<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="540.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cse213project.bookfair.Raquibul.controller.ManagerCounterSalesController">
    <children>
        <Label layoutX="20.0" layoutY="15.0" text="Goal 3: POS Counter Sales &amp; Pre-Order Pickup Fulfillment" />

        <Label layoutX="20.0" layoutY="50.0" text="Book ISBN:" />
        <TextField fx:id="isbnTextField" layoutX="95.0" layoutY="46.0" prefWidth="135.0" text="978-984-01" />
        <Label layoutX="245.0" layoutY="50.0" text="Qty:" />
        <TextField fx:id="qtyTextField" layoutX="280.0" layoutY="46.0" prefWidth="65.0" text="1" />
        <Label layoutX="360.0" layoutY="50.0" text="Payment:" />
        <ComboBox fx:id="paymentMethodComboBox" layoutX="425.0" layoutY="46.0" prefWidth="115.0" />
        <Button layoutX="555.0" layoutY="46.0" prefWidth="185.0" onAction="#recordSaleButtonOnAction" text="Record Sale &amp; E-Receipt" />

        <Label layoutX="20.0" layoutY="95.0" text="Pre-Order ID:" />
        <TextField fx:id="preOrderIdTextField" layoutX="105.0" layoutY="91.0" prefWidth="125.0" text="PO-1002" />
        <Label layoutX="245.0" layoutY="95.0" text="Pickup Code:" />
        <TextField fx:id="pickupCodeTextField" layoutX="330.0" layoutY="91.0" prefWidth="115.0" text="PK-2222" />
        <Button layoutX="460.0" layoutY="91.0" prefWidth="165.0" onAction="#fulfillPreOrderButtonOnAction" text="Fulfill Pre-Order" />
        <Button layoutX="640.0" layoutY="91.0" prefWidth="100.0" onAction="#backButtonOnAction" text="Back" />

        <Label fx:id="receiptLabel" layoutX="20.0" layoutY="135.0" prefWidth="720.0" text="" />

        <TableView fx:id="salesTableView" layoutX="20.0" layoutY="165.0" prefHeight="350.0" prefWidth="720.0">
            <columns>
                <TableColumn fx:id="saleIdCol" prefWidth="105.0" text="Sale ID" />
                <TableColumn fx:id="isbnCol" prefWidth="140.0" text="ISBN" />
                <TableColumn fx:id="qtyCol" prefWidth="70.0" text="Qty" />
                <TableColumn fx:id="totalCol" prefWidth="135.0" text="Net Total (BDT)" />
                <TableColumn fx:id="paymentCol" prefWidth="125.0" text="Payment" />
                <TableColumn fx:id="dateCol" prefWidth="140.0" text="Date" />
            </columns>
        </TableView>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="540.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cse213project.bookfair.Raquibul.controller.VisitorLostFoundController">
    <children>
        <Label layoutX="20.0" layoutY="15.0" text="Goal 6: Report Lost &amp; Found Items / Submit Ownership Claim" />

        <Label layoutX="20.0" layoutY="50.0" text="Type:" />
        <ComboBox fx:id="reportTypeComboBox" layoutX="65.0" layoutY="46.0" prefWidth="120.0" />
        <Label layoutX="200.0" layoutY="50.0" text="Category:" />
        <ComboBox fx:id="categoryComboBox" layoutX="265.0" layoutY="46.0" prefWidth="120.0" />
        <Label layoutX="400.0" layoutY="50.0" text="Location:" />
        <TextField fx:id="locationTextField" layoutX="460.0" layoutY="46.0" prefWidth="120.0" />
        <Label layoutX="590.0" layoutY="50.0" text="Phone:" />
        <TextField fx:id="phoneTextField" layoutX="635.0" layoutY="46.0" prefWidth="105.0" text="01711000001" />

        <Label layoutX="20.0" layoutY="90.0" text="Description:" />
        <TextField fx:id="descriptionTextField" layoutX="100.0" layoutY="86.0" prefWidth="480.0" />
        <Button layoutX="595.0" layoutY="86.0" prefWidth="145.0" onAction="#submitReportButtonOnAction" text="Submit Report" />

        <TableView fx:id="itemTableView" layoutX="20.0" layoutY="130.0" prefHeight="250.0" prefWidth="720.0">
            <columns>
                <TableColumn fx:id="itemIdCol" prefWidth="110.0" text="Item ID" />
                <TableColumn fx:id="typeCol" prefWidth="120.0" text="Type" />
                <TableColumn fx:id="categoryCol" prefWidth="130.0" text="Category" />
                <TableColumn fx:id="locationCol" prefWidth="220.0" text="Location" />
                <TableColumn fx:id="statusCol" prefWidth="135.0" text="Status" />
            </columns>
        </TableView>

        <Label layoutX="20.0" layoutY="400.0" text="Claim Proof:" />
        <TextField fx:id="proofDetailsTextField" layoutX="100.0" layoutY="396.0" prefWidth="350.0" />
        <Button layoutX="465.0" layoutY="396.0" prefWidth="155.0" onAction="#claimSelectedItemButtonOnAction" text="Claim Selected Item" />
        <Button layoutX="640.0" layoutY="396.0" prefWidth="100.0" onAction="#backButtonOnAction" text="Back" />

        <Label fx:id="statusLabel" layoutX="20.0" layoutY="445.0" prefWidth="720.0" text="" />
    </children>
</AnchorPane>

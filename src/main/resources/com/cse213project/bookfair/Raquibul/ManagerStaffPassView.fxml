<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="520.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cse213project.bookfair.Raquibul.controller.ManagerStaffPassController">
    <children>
        <Label layoutX="20.0" layoutY="15.0" text="Goal 4: Manage Stall Attendant Staff Passes (Quota: Max 5 Active)" />

        <Label layoutX="20.0" layoutY="55.0" text="Staff Name:" />
        <TextField fx:id="staffNameTextField" layoutX="95.0" layoutY="51.0" prefWidth="170.0" />
        <Label layoutX="280.0" layoutY="55.0" text="NID (10/17 digits):" />
        <TextField fx:id="nidTextField" layoutX="395.0" layoutY="51.0" prefWidth="165.0" />
        <Label layoutX="575.0" layoutY="55.0" text="Role:" />
        <ComboBox fx:id="roleComboBox" layoutX="615.0" layoutY="51.0" prefWidth="125.0" />

        <Label layoutX="20.0" layoutY="95.0" text="Phone (11 digits):" />
        <TextField fx:id="contactTextField" layoutX="130.0" layoutY="91.0" prefWidth="140.0" text="01711000010" />
        <Button layoutX="290.0" layoutY="91.0" prefWidth="150.0" onAction="#issuePassButtonOnAction" text="Issue Staff Pass" />
        <Button layoutX="455.0" layoutY="91.0" prefWidth="160.0" onAction="#revokePassButtonOnAction" text="Revoke Selected Pass" />
        <Button layoutX="640.0" layoutY="91.0" prefWidth="100.0" onAction="#backButtonOnAction" text="Back" />

        <Label fx:id="statusLabel" layoutX="20.0" layoutY="135.0" prefWidth="720.0" text="" />

        <TableView fx:id="passTableView" layoutX="20.0" layoutY="165.0" prefHeight="330.0" prefWidth="720.0">
            <columns>
                <TableColumn fx:id="passIdCol" prefWidth="105.0" text="Pass ID" />
                <TableColumn fx:id="nameCol" prefWidth="175.0" text="Staff Name" />
                <TableColumn fx:id="roleCol" prefWidth="145.0" text="Role" />
                <TableColumn fx:id="qrCol" prefWidth="195.0" text="Badge QR" />
                <TableColumn fx:id="activeCol" prefWidth="95.0" text="Active" />
            </columns>
        </TableView>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="460.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cse213project.bookfair.Raquibul.controller.GeneralVisitorDashboardController">
    <children>
        <Label fx:id="welcomeLabel" layoutX="40.0" layoutY="25.0" text="General Visitor Dashboard" />
        <Button layoutX="40.0" layoutY="80.0" prefWidth="280.0" onAction="#openSearchBooksOnAction" text="Search Books, Authors &amp; Stalls" />
        <Button layoutX="360.0" layoutY="80.0" prefWidth="280.0" onAction="#openPreOrderBookOnAction" text="Pre-Order Books" />
        <Button layoutX="40.0" layoutY="140.0" prefWidth="280.0" onAction="#openRegisterEventOnAction" text="Register for Events &amp; Launches" />
        <Button layoutX="360.0" layoutY="140.0" prefWidth="280.0" onAction="#openSubmitReviewOnAction" text="Submit Book Reviews &amp; Ratings" />
        <Button layoutX="40.0" layoutY="200.0" prefWidth="280.0" onAction="#openBuyEntryPassOnAction" text="Purchase Fair Entry Pass" />
        <Button layoutX="360.0" layoutY="200.0" prefWidth="280.0" onAction="#openLostFoundOnAction" text="Report / Claim Lost &amp; Found" />
        <Button layoutX="40.0" layoutY="260.0" prefWidth="280.0" onAction="#openApplyVoucherOnAction" text="Apply Discount Voucher Code" />
        <Button layoutX="360.0" layoutY="260.0" prefWidth="280.0" onAction="#openFeedbackHelplineOnAction" text="Feedback / Emergency Helpline" />
        <Button layoutX="280.0" layoutY="360.0" prefWidth="120.0" onAction="#signOutButtonOnAction" text="Sign Out" />
    </children>
</AnchorPane>

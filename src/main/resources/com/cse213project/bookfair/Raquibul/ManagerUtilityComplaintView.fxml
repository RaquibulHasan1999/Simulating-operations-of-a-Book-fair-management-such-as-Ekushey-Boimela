<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cse213project.bookfair.Raquibul.controller.ManagerUtilityComplaintController">
    <children>
        <Label layoutX="20.0" layoutY="15.0" text="Goal 8: Submit Stall Utility Maintenance or Security Complaint" />

        <Label layoutX="20.0" layoutY="55.0" text="Category:" />
        <ComboBox fx:id="categoryComboBox" layoutX="90.0" layoutY="51.0" prefWidth="140.0" />
        <Label layoutX="250.0" layoutY="55.0" text="Priority:" />
        <ComboBox fx:id="priorityComboBox" layoutX="310.0" layoutY="51.0" prefWidth="110.0" />

        <Label layoutX="20.0" layoutY="95.0" text="Description:" />
        <TextField fx:id="descriptionTextField" layoutX="100.0" layoutY="91.0" prefWidth="420.0" />
        <Button layoutX="530.0" layoutY="91.0" prefWidth="110.0" onAction="#submitComplaintButtonOnAction" text="Submit Ticket" />
        <Button layoutX="650.0" layoutY="91.0" prefWidth="90.0" onAction="#backButtonOnAction" text="Back" />

        <Label fx:id="statusLabel" layoutX="20.0" layoutY="135.0" prefWidth="720.0" text="" />

        <TableView fx:id="complaintTableView" layoutX="20.0" layoutY="165.0" prefHeight="310.0" prefWidth="720.0">
            <columns>
                <TableColumn fx:id="compIdCol" prefWidth="95.0" text="Ticket ID" />
                <TableColumn fx:id="typeCol" prefWidth="105.0" text="Category" />
                <TableColumn fx:id="priorityCol" prefWidth="80.0" text="Priority" />
                <TableColumn fx:id="statusCol" prefWidth="165.0" text="Status" />
                <TableColumn fx:id="descCol" prefWidth="270.0" text="Description" />
            </columns>
        </TableView>
    </children>
</AnchorPane>

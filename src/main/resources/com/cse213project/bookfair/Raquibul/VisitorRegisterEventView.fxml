<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="480.0" prefWidth="740.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cse213project.bookfair.Raquibul.controller.VisitorRegisterEventController">
    <children>
        <Label layoutX="20.0" layoutY="20.0" text="Register for Author Meet &amp; Greet / Book Launch Sessions" />
        <TableView fx:id="eventTableView" layoutX="20.0" layoutY="60.0" prefHeight="290.0" prefWidth="700.0">
            <columns>
                <TableColumn fx:id="eventIdCol" prefWidth="95.0" text="Event ID" />
                <TableColumn fx:id="titleCol" prefWidth="230.0" text="Event Title" />
                <TableColumn fx:id="dateCol" prefWidth="120.0" text="Date" />
                <TableColumn fx:id="stageCol" prefWidth="160.0" text="Stage" />
                <TableColumn fx:id="seatsCol" prefWidth="90.0" text="Seats Left" />
            </columns>
        </TableView>
        <Button layoutX="20.0" layoutY="370.0" prefWidth="210.0" onAction="#registerEventButtonOnAction" text="Confirm Event Registration" />
        <Button layoutX="620.0" layoutY="370.0" prefWidth="100.0" onAction="#backButtonOnAction" text="Back" />
        <Label fx:id="passLabel" layoutX="20.0" layoutY="420.0" prefWidth="700.0" text="Select an event session and click Confirm." />
    </children>
</AnchorPane>

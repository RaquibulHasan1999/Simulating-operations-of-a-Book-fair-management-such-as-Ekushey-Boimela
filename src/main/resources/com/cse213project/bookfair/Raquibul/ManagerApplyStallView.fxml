<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="520.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cse213project.bookfair.Raquibul.controller.ManagerApplyStallController">
    <children>
        <Label layoutX="20.0" layoutY="15.0" text="Goal 1: Apply for Fair Stall Allocation" />
        <Label layoutX="20.0" layoutY="55.0" text="Stall Type:" />
        <ComboBox fx:id="stallTypeComboBox" layoutX="95.0" layoutY="51.0" prefWidth="130.0" />
        <Label layoutX="245.0" layoutY="55.0" text="Preferred Zone:" />
        <ComboBox fx:id="preferredZoneComboBox" layoutX="345.0" layoutY="51.0" prefWidth="200.0" />

        <Label layoutX="20.0" layoutY="95.0" text="Trade License:" />
        <TextField fx:id="tradeLicenseTextField" layoutX="115.0" layoutY="91.0" prefWidth="150.0" />
        <Label layoutX="285.0" layoutY="95.0" text="Doc (.pdf/.jpg):" />
        <TextField fx:id="documentFileTextField" layoutX="385.0" layoutY="91.0" prefWidth="180.0" />

        <Button layoutX="20.0" layoutY="135.0" prefWidth="190.0" onAction="#submitApplicationButtonOnAction" text="Submit Stall Application" />
        <Button layoutX="640.0" layoutY="135.0" prefWidth="100.0" onAction="#backButtonOnAction" text="Back" />

        <Label fx:id="statusLabel" layoutX="20.0" layoutY="175.0" prefWidth="720.0" text="" />

        <TableView fx:id="applicationTableView" layoutX="20.0" layoutY="205.0" prefHeight="290.0" prefWidth="720.0">
            <columns>
                <TableColumn fx:id="appIdCol" prefWidth="95.0" text="App ID" />
                <TableColumn fx:id="publisherCol" prefWidth="135.0" text="Publisher" />
                <TableColumn fx:id="typeCol" prefWidth="170.0" text="Stall Type &amp; Zone" />
                <TableColumn fx:id="licenseCol" prefWidth="105.0" text="License No" />
                <TableColumn fx:id="statusCol" prefWidth="115.0" text="Status" />
                <TableColumn fx:id="dateCol" prefWidth="95.0" text="Date" />
            </columns>
        </TableView>
    </children>
</AnchorPane>

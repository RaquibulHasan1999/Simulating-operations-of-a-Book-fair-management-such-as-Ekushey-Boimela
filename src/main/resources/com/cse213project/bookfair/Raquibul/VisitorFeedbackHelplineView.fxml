<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="740.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cse213project.bookfair.Raquibul.controller.VisitorFeedbackHelplineController">
    <children>
        <Label layoutX="20.0" layoutY="18.0" text="Goal 8: Submit Feedback or Emergency Assistance Request" />
        <Label layoutX="20.0" layoutY="58.0" text="Issue Type:" />
        <ComboBox fx:id="issueTypeComboBox" layoutX="95.0" layoutY="54.0" prefWidth="140.0" />
        <Label layoutX="250.0" layoutY="58.0" text="Rating (1-5):" />
        <ComboBox fx:id="ratingComboBox" layoutX="335.0" layoutY="54.0" prefWidth="80.0" />
        <Label layoutX="430.0" layoutY="58.0" text="Zone/GPS:" />
        <TextField fx:id="zoneTextField" layoutX="500.0" layoutY="54.0" prefWidth="220.0" />

        <Label layoutX="20.0" layoutY="98.0" text="Message:" />
        <TextField fx:id="messageTextField" layoutX="95.0" layoutY="94.0" prefWidth="625.0" />

        <Button layoutX="20.0" layoutY="138.0" prefWidth="200.0" onAction="#submitAlertOrFeedbackButtonOnAction" text="Submit Request / Alert" />
        <Button layoutX="620.0" layoutY="138.0" prefWidth="100.0" onAction="#backButtonOnAction" text="Back" />

        <Label fx:id="dispatchLabel" layoutX="20.0" layoutY="178.0" prefWidth="700.0" text="" />

        <TableView fx:id="feedbackTableView" layoutX="20.0" layoutY="208.0" prefHeight="265.0" prefWidth="700.0">
            <columns>
                <TableColumn fx:id="fbIdCol" prefWidth="110.0" text="Ref ID" />
                <TableColumn fx:id="categoryCol" prefWidth="120.0" text="Category" />
                <TableColumn fx:id="ratingCol" prefWidth="80.0" text="Rating" />
                <TableColumn fx:id="commentCol" prefWidth="385.0" text="Details" />
            </columns>
        </TableView>
    </children>
</AnchorPane>

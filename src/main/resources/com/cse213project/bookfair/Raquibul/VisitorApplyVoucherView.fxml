<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="480.0" prefWidth="740.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cse213project.bookfair.Raquibul.controller.VisitorApplyVoucherController">
    <children>
        <Label layoutX="20.0" layoutY="18.0" text="Apply Discount / Promo Voucher Code (Demo Codes: BOIMELA10, EKUSHEY20)" />
        <TableView fx:id="orderTableView" layoutX="20.0" layoutY="55.0" prefHeight="270.0" prefWidth="700.0">
            <columns>
                <TableColumn fx:id="orderIdCol" prefWidth="120.0" text="Order ID" />
                <TableColumn fx:id="isbnCol" prefWidth="150.0" text="ISBN" />
                <TableColumn fx:id="voucherCol" prefWidth="135.0" text="Voucher" />
                <TableColumn fx:id="discountCol" prefWidth="140.0" text="Discount (BDT)" />
                <TableColumn fx:id="totalCol" prefWidth="150.0" text="Total (BDT)" />
            </columns>
        </TableView>
        <Label layoutX="20.0" layoutY="350.0" text="Voucher Code:" />
        <TextField fx:id="voucherCodeTextField" layoutX="120.0" layoutY="346.0" prefWidth="180.0" />
        <Button layoutX="320.0" layoutY="346.0" prefWidth="160.0" onAction="#applyVoucherButtonOnAction" text="Apply Voucher" />
        <Button layoutX="620.0" layoutY="346.0" prefWidth="100.0" onAction="#backButtonOnAction" text="Back" />
        <Label fx:id="resultLabel" layoutX="20.0" layoutY="400.0" prefWidth="700.0" text="Select an active Pre-Order and enter a promo code." />
    </children>
</AnchorPane>
